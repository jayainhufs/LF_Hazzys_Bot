# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.python-version
*.egg-info/

# 가상환경
.venv/
venv/
env/

# 환경변수 (절대 커밋 금지)
.env
.env.local

# 사용자 데이터 / 색인 결과 (구조만 유지하고 내용은 커밋하지 않음)
data/raw/**/*
!data/raw/**/.gitkeep
data/processed/**/*
!data/processed/**/.gitkeep
data/sample/**/*
!data/sample/.gitkeep
!data/sample/README.md

storage/chroma_db/**/*
!storage/chroma_db/.gitkeep
storage/qa_logs/**/*
!storage/qa_logs/.gitkeep
storage/registry/**/*
!storage/registry/.gitkeep

# 내부 참조용 문서 (커밋 절대 금지)
# docs_internal_template/ 은 공개 가능한 템플릿이므로 추적 가능.
docs_internal/
*.private.md
INTERNAL_*.md
PRIVATE_*.md

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# pytest / mypy
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
# Local reindex backups - never commit
backup_before_reindex*/
backup_before_reindex_*/
LF_Hazzys_Bot_BACKUPS/
*.sqlite3-shm
*.sqlite3-wal
