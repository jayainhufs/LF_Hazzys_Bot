# ============================================================================
# Work RAG Assistant - 환경변수 예시
# 사용법: 이 파일을 .env 로 복사한 뒤, 값들을 채워넣는다.
#   Mac:     cp .env.example .env
#   Windows: copy .env.example .env
# ============================================================================

APP_NAME=Work RAG Assistant
ENV=local

# ----------------------------- 경로 설정 -------------------------------------
# 모든 경로는 프로젝트 루트 기준 상대 경로 사용을 권장한다.
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CHROMA_DB_DIR=./storage/chroma_db
QA_LOG_DIR=./storage/qa_logs
REGISTRY_PATH=./storage/registry/indexed_files.json
EXCEL_SUMMARY_DIR=./data/processed/summaries/excel

# ----------------------------- Google API ------------------------------------
# https://aistudio.google.com/app/apikey 에서 발급
GOOGLE_API_KEY=

# 모델명은 시점/계정에 따라 달라질 수 있으므로 .env 에서 자유롭게 교체.
GENERATION_MODEL=gemini-2.5-flash-lite
FALLBACK_GENERATION_MODEL=gemini-2.5-flash
EXCEL_SUMMARY_MODEL=gemini-2.5-flash-lite

# ----------------------------- 임베딩 설정 -----------------------------------
# gemini  -> Google Gemini Embedding API 사용
# local   -> sentence-transformers 기반 로컬 임베딩 사용
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# ----------------------------- RAG 파라미터 ----------------------------------
TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# 비용 절약 옵션
ENABLE_QUERY_REWRITE=false
ENABLE_EXCEL_SUMMARY=false

MAX_CONTEXT_CHARS=6000
MAX_CHUNKS_PER_FILE=2
REQUEST_TIMEOUT_SECONDS=60

# ----------------------------- 검색 정밀도 (Retrieval precision) -------------
# raw similarity (cosine 기반, 1 - distance) 가 이 값보다 낮으면 제거
MIN_SIMILARITY_SCORE=0.35
# source_weight / category_boost / content_type_boost 가 적용된 final_score 가
# 이 값보다 낮으면 제거
MIN_FINAL_SCORE=0.30
# threshold 통과 chunk 수가 이 값 미만이면 근거 부족으로 처리 (generation skip)
MIN_RETRIEVED_CHUNKS=1
# 비슷한 chunk 반복 방지 (MMR 비슷한 휴리스틱)
USE_MMR=true
MMR_LAMBDA=0.7

# ----------------------------- Date / Topic-aware retrieval ------------------
# 질문에 날짜가 들어 있고 chunk.document_date 와 일치하면 final_score 에 곱한다.
DATE_EXACT_MATCH_BOOST=1.25
# 질문 날짜 != chunk 날짜 인 경우 final_score 에 곱한다.
DATE_MISMATCH_PENALTY=0.55
# true 면 query_date 와 다른 document_date 를 가진 chunk 는 검색 결과에서 제거한다.
ENABLE_DATE_FILTER=false
# 질문 topic 과 chunk topic_tags 가 겹치면 final_score 에 곱한다.
TOPIC_MATCH_BOOST=1.20
# 질문 topic 이 있는데 chunk topic_tags 가 비어있거나 겹치지 않으면 곱한다.
# (단, guide 문서/procedure 질문 조합에는 약하게 적용됨)
TOPIC_MISMATCH_PENALTY=0.80

# ----------------------------- 출력 비식별화 (Anonymization) -----------------
# 원본 raw 문서는 변경되지 않는다. UI/QA 답변/prompt context 출력에만 적용.
ANONYMIZE_OUTPUT=true
SHOW_RAW_CONTENT=false
SHOW_SPEAKER_NAMES=false
SHOW_EXACT_TIMESTAMPS=false
SHOW_EXACT_DATES=false
MASK_MENTIONS=true
MASK_LINKS=true
MASK_FILE_NAMES=false
ANONYMIZED_DATE_LABEL=업무일
ANONYMIZED_TIME_LABEL=시간대

# ----------------------------- LLM-based Document Normalization --------------
# raw 업무 문서를 LLM 으로 절차/체크리스트/이슈/FAQ/공유 문안 등 검색·QA 친화적
# 구조 (Normalized Document) 로 정규화하는 ingestion-time preprocessing 단계.
# Task 1 에서는 schema/store 만 준비하고, 실제 LLM 호출은 Task 2~3 에서 구현된다.
ENABLE_LLM_NORMALIZATION=false

# 신규 권장 env. 기존 LLM_NORMALIZATION_MODEL 도 fallback 으로 인식된다.
LLM_DOCUMENT_NORMALIZATION_MODEL=gemini-2.5-flash-lite
# legacy 호환: 위 env 가 비어 있으면 아래 값이 사용된다.
# LLM_NORMALIZATION_MODEL=gemini-2.5-flash-lite

NORMALIZATION_OUTPUT_DIR=data/processed/normalized
NORMALIZATION_CACHE_DIR=data/processed/normalized/cache
NORMALIZATION_MAX_CHARS_PER_CALL=18000

# 신규 권장 env. legacy: NORMALIZATION_MAX_CARDS_PER_FILE
NORMALIZATION_MAX_DOCUMENTS_PER_FILE=30

NORMALIZATION_TEMPERATURE=0.1
NORMALIZATION_USE_ANONYMIZED_INPUT=true
NORMALIZATION_SAVE_JSON=true
NORMALIZATION_SAVE_MARKDOWN=true

# 신규 권장 env. legacy: NORMALIZATION_CARD_SOURCE_WEIGHT
NORMALIZED_DOCUMENT_SOURCE_WEIGHT=1.25

NORMALIZATION_PARENT_RAW_TOP_K=3

# ----------------------------- Normalized Document 우선 retrieval (Task 6) ---
# 검색 결과에서 content_type=normalized_document (legacy: knowledge_card) /
# source_type=llm_normalized chunk 를 raw chunk 보다 우선 반환한다.
# raw chunk 는 보조 근거/fallback 용도로 남겨둔다.
# 신규 권장 env. legacy 명도 fallback 으로 인식된다.
PRIORITIZE_NORMALIZED_DOCUMENTS=true
NORMALIZED_DOCUMENT_CONTENT_BOOST=1.35
# legacy 호환:
# PRIORITIZE_KNOWLEDGE_CARDS=true
# KNOWLEDGE_CARD_CONTENT_BOOST=1.35

WORKFLOW_CARD_BOOST=1.30
CHECKLIST_CARD_BOOST=1.25
FAQ_CARD_BOOST=1.20
DECISION_CARD_BOOST=1.20
COMMUNICATION_TEMPLATE_BOOST=1.20
GLOSSARY_CARD_BOOST=1.10
# 같은 source_file 에 normalized_document 가 있으면 raw chunk 점수에 곱해 살짝 누른다.
RAW_EVIDENCE_BOOST=0.85
# 검색 결과 진단에서 normalized_document 의 parent_raw_chunk_ids 를 노출한다.
ENABLE_PARENT_RAW_EVIDENCE=true
PARENT_RAW_EVIDENCE_TOP_K=2

# ----------------------------- Normalized Document 중심 답변 (Task 7) --------
# QA 답변 단계에서 primary normalized document 를 1차 근거로 사용한다.
# raw evidence/fallback 은 보조 또는 fallback 용도로만 사용한다.
# 신규 권장 env. legacy 명도 fallback 으로 인식된다.
ANSWER_WITH_NORMALIZED_DOCUMENTS=true
# QA prompt 에 포함할 primary normalized document 최대 개수.
MAX_PRIMARY_NORMALIZED_DOCUMENTS=5
# legacy 호환:
# ANSWER_WITH_KNOWLEDGE_CARDS=true
# MAX_PRIMARY_CARDS=5

# 보조 근거로 포함할 raw chunk 최대 개수.
MAX_RAW_EVIDENCE_CHUNKS=3
# raw evidence 를 prompt 에 보조 근거 섹션으로 추가할지 여부.
INCLUDE_RAW_EVIDENCE_APPENDIX=true
# 답변 prompt 변경 추적용 버전 라벨 (qa log 에 기록됨).
# 신규: NORMALIZED_DOCUMENT_ANSWER_TEMPLATE_VERSION
# legacy: KNOWLEDGE_CARD_ANSWER_TEMPLATE_VERSION
NORMALIZED_DOCUMENT_ANSWER_TEMPLATE_VERSION=normalized_document_v1

# ----------------------------- ChromaDB --------------------------------------
CHROMA_COLLECTION=work_knowledge
