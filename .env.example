# ============================================================================
# Work RAG Assistant - 환경변수 예시
# 사용법: 이 파일을 .env 로 복사한 뒤, 값들을 채워넣는다.
#   Mac:     cp .env.example .env
#   Windows: copy .env.example .env
# ============================================================================

APP_NAME=Work RAG Assistant
ENV=local

# ----------------------------- 경로 설정 -------------------------------------
# 모든 경로는 프로젝트 루트 기준 상대 경로 사용을 권장한다.
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CHROMA_DB_DIR=./storage/chroma_db
QA_LOG_DIR=./storage/qa_logs
REGISTRY_PATH=./storage/registry/indexed_files.json
EXCEL_SUMMARY_DIR=./data/processed/summaries/excel

# ----------------------------- Google API ------------------------------------
# https://aistudio.google.com/app/apikey 에서 발급
GOOGLE_API_KEY=

# 모델명은 시점/계정에 따라 달라질 수 있으므로 .env 에서 자유롭게 교체.
GENERATION_MODEL=gemini-2.5-flash-lite
FALLBACK_GENERATION_MODEL=gemini-2.5-flash
EXCEL_SUMMARY_MODEL=gemini-2.5-flash-lite

# ----------------------------- 임베딩 설정 -----------------------------------
# gemini  -> Google Gemini Embedding API 사용
# local   -> sentence-transformers 기반 로컬 임베딩 사용
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# ----------------------------- RAG 파라미터 ----------------------------------
TOP_K=8
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# 비용 절약 옵션
ENABLE_QUERY_REWRITE=false
ENABLE_EXCEL_SUMMARY=false

MAX_CONTEXT_CHARS=12000
MAX_CHUNKS_PER_FILE=3
REQUEST_TIMEOUT_SECONDS=60

# ----------------------------- ChromaDB --------------------------------------
CHROMA_COLLECTION=work_knowledge
